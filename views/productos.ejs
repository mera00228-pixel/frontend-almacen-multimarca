<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Inventario | Almacén Multimarca</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">

    <header class="topbar">
        <div class="topbar-marca">Almacén Multimarca</div>
        <div class="topbar-usuario">
            <span id="usuarioLabel" class="topbar-nombre"></span>
            <button id="btnLogout" class="btn btn-secundario">Salir</button>
        </div>
    </header>

    <main class="contenido">
        <div class="toolbar">
            <input id="buscador" type="search" placeholder="Buscar por nombre o código de barras..." class="buscador">
            <button id="btnNuevo" class="btn btn-primario">+ Nuevo producto</button>
        </div>

        <p id="aviso" class="form-mensaje" role="alert"></p>

        <section class="panel">
            <div class="panel-resumen">
                <span id="totalProductos"></span>
                <span id="valorInventario" class="resumen-valor"></span>
            </div>

            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Marca ID</th>
                            <th>Cat. ID</th>
                            <th>Compra</th>
                            <th>Venta</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tablaBody">
                        <tr><td colspan="10" class="celda-vacia">Cargando productos...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="modalProducto" class="modal oculto">
        <div class="modal-caja">
            <div class="modal-cabecera">
                <h2 id="modalTitulo">Nuevo producto</h2>
                <button id="btnCerrarModal" class="modal-cerrar" type="button" aria-label="Cerrar">&times;</button>
            </div>

            <form id="formProducto">
                <input type="hidden" id="productoId">

                <div class="form-grid">
                    <label>Código de barras
                        <input type="text" id="codigo_barras" required>
                    </label>

                    <label>Nombre
                        <input type="text" id="nombre" required>
                    </label>

                    <label class="col-span-2">Descripción
                        <textarea id="descripcion" rows="2"></textarea>
                    </label>

                    <label>Precio compra
                        <input type="number" id="precio_compra" min="0" step="0.01" required>
                    </label>

                    <label>Precio venta
                        <input type="number" id="precio_venta" min="0" step="0.01" required>
                    </label>

                    <label>Stock
                        <input type="number" id="stock" min="0" step="1" required>
                    </label>

                    <label>Stock mínimo
                        <input type="number" id="stock_minimo" min="0" step="1" value="5">
                    </label>

                    <label>Marca (ID)
                        <input type="number" id="marca_id" min="1" placeholder="1">
                    </label>

                    <label>Categoría (ID)
                        <input type="number" id="categoria_id" min="1" placeholder="1">
                    </label>

                    <label>Estado
                        <select id="estado">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </label>
                </div>

                <p id="avisoForm" class="form-mensaje" role="alert"></p>

                <div class="modal-acciones">
                    <button type="button" id="btnCancelar" class="btn btn-secundario">Cancelar</button>
                    <button type="submit" id="btnGuardar" class="btn btn-primario">Guardar</button>
                </div>
            </form>
        </div>
    </div>

<script>window.__API_URL__ = '<%= apiUrl %>';</script>
<script type="module" src="/js/productos.js"></script>
</body>
</html>
