<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Inventario | Almacén Multimarca</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">

    <header class="topbar">
        <div class="topbar-marca">Almacén Multimarca</div>
        <div class="topbar-usuario">
            <span id="usuarioLabel" class="topbar-nombre"></span>
            <button id="btnLogout" class="btn btn-secundario">Salir</button>
        </div>
    </header>

    <main class="contenido">
        <section class="kpis">
            <article class="kpi kpi-productos">
                <span class="kpi-valor" id="kpiProductos">0</span>
                <span class="kpi-etiqueta">Total de Productos</span>
            </article>
            <article class="kpi kpi-stock">
                <span class="kpi-valor" id="kpiStock">0</span>
                <span class="kpi-etiqueta">Stock Total</span>
            </article>
            <article class="kpi kpi-inventario">
                <span class="kpi-valor" id="kpiValor">$ 0,00</span>
                <span class="kpi-etiqueta">Valor del Inventario</span>
            </article>
            <article class="kpi kpi-alertas">
                <span class="kpi-valor" id="kpiAlertas">0</span>
                <span class="kpi-etiqueta">Alertas de Stock Bajo</span>
            </article>
        </section>

        <div class="toolbar">
            <input id="buscador" type="search" placeholder="Buscar por nombre, código, marca o categoría..." class="buscador">
            <div class="toolbar-acciones">
                <button id="btnExportarPdf" class="btn btn-secundario">Exportar a PDF</button>
                <button id="btnExportarExcel" class="btn btn-secundario">Exportar a Excel</button>
                <button id="btnNuevo" class="btn btn-primario">+ Nuevo producto</button>
            </div>
        </div>

        <p id="aviso" class="form-mensaje" role="alert"></p>

        <section class="panel">
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Imagen</th>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Marca</th>
                            <th>Categoría</th>
                            <th>Compra</th>
                            <th>Venta</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tablaBody">
                        <tr><td colspan="11" class="celda-vacia">Cargando productos...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <div id="modalProducto" class="modal oculto">
        <div class="modal-caja">
            <div class="modal-cabecera">
                <h2 id="modalTitulo">Nuevo producto</h2>
                <button id="btnCerrarModal" class="modal-cerrar" type="button" aria-label="Cerrar">&times;</button>
            </div>

            <form id="formProducto">
                <input type="hidden" id="productoId">

                <div class="form-grid">
                    <label>Código de barras
                        <input type="text" id="codigo_barras" required>
                    </label>

                    <label>Nombre
                        <input type="text" id="nombre" required>
                    </label>

                    <label class="col-span-2">Descripción
                        <textarea id="descripcion" rows="2"></textarea>
                    </label>

                    <label>Precio compra
                        <input type="number" id="precio_compra" min="0" step="0.01" required>
                    </label>

                    <label>Precio venta
                        <input type="number" id="precio_venta" min="0" step="0.01" required>
                    </label>

                    <label>Stock
                        <input type="number" id="stock" min="0" step="1" required>
                    </label>

                    <label>Stock mínimo
                        <input type="number" id="stock_minimo" min="0" step="1" value="5">
                    </label>

                    <label class="col-span-2">Imagen (URL)
                        <input type="url" id="imagen_url" placeholder="https://ejemplo.com/imagen.jpg">
                        <img id="imagenPreview" class="form-preview oculto" alt="Vista previa">
                    </label>

                    <label>Marca (ID)
                        <input type="number" id="marca_id" min="1" placeholder="1">
                    </label>

                    <label>Categoría (ID)
                        <input type="number" id="categoria_id" min="1" placeholder="1">
                    </label>

                    <label>Estado
                        <select id="estado">
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </label>
                </div>

                <p id="avisoForm" class="form-mensaje" role="alert"></p>

                <div class="modal-acciones">
                    <button type="button" id="btnCancelar" class="btn btn-secundario">Cancelar</button>
                    <button type="submit" id="btnGuardar" class="btn btn-primario">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modalMovimiento" class="modal oculto">
        <div class="modal-caja modal-mini">
            <div class="modal-cabecera">
                <h2 id="movimientoTitulo">Registrar movimiento</h2>
                <button id="btnCerrarMovimiento" class="modal-cerrar" type="button" aria-label="Cerrar">&times;</button>
            </div>

            <p id="movimientoProducto" class="mov-producto"></p>
            <p class="mov-stock">Stock actual: <strong id="movimientoStockActual">0</strong></p>

            <form id="formMovimiento">
                <input type="hidden" id="movimientoProductoId">
                <input type="hidden" id="movimientoTipo">

                <label>Cantidad
                    <input type="number" id="movimientoCantidad" min="1" step="1" required>
                </label>

                <label>Motivo (opcional)
                    <input type="text" id="movimientoMotivo" maxlength="200" placeholder="Compra, venta, ajuste de inventario...">
                </label>

                <p id="movimientoAviso" class="form-mensaje" role="alert"></p>

                <div class="modal-acciones">
                    <button type="button" id="btnCancelarMovimiento" class="btn btn-secundario">Cancelar</button>
                    <button type="submit" id="btnRegistrarMovimiento" class="btn btn-primario">Registrar</button>
                </div>
            </form>
        </div>
    </div>

<script>window.__API_URL__ = '<%= apiUrl %>';</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script type="module" src="/js/productos.js"></script>
</body>
</html>
